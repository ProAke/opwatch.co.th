# ── Database (MariaDB / MySQL) ───────────────────────────────────────────────
# Leave DB_HOST empty to run the console in DEMO mode (seeded in-memory dataset).
DB_HOST=
DB_PORT=3306
DB_NAME=ai_uarea
DB_USER=ai_uarea
DB_PASSWORD=

# ── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── AI providers (any subset; the console falls back to its simulator) ───────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=
OLLAMA_BASE_URL=

# ── Integrations ────────────────────────────────────────────────────────────
# ตั้ง token เพื่อให้หน้า Integrations ดึงรายการ repo จริงและเปิด Issue/PR ได้
# (ไม่ตั้ง = ใช้รายการ repo ตัวอย่าง แต่ยังเลือก/ผูก repo ได้)
GITHUB_TOKEN=
# ไม่บังคับ: ดึง repo ขององค์กรนี้เพิ่มจาก repo ส่วนตัวของผู้ใช้
GITHUB_OWNER=
GOOGLE_DRIVE_FOLDER_ID=
MNG_BASE_URL=https://mng.uarea.in
MNG_API_KEY=
MNG_WEBHOOK_SECRET=
MCP_TOKEN=
