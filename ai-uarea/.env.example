# ── Database (MariaDB / MySQL) ───────────────────────────────────────────────
# Leave DB_HOST empty to run the console in DEMO mode (seeded in-memory dataset).
DB_HOST=
DB_PORT=3306
DB_NAME=ai_uarea
DB_USER=ai_uarea
DB_PASSWORD=

# ── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── AI providers (any subset; the console falls back to its simulator) ───────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=
OLLAMA_BASE_URL=

# ── Integrations ────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=jaturapornchai
GOOGLE_DRIVE_FOLDER_ID=
MNG_BASE_URL=https://mng.uarea.in
MNG_API_KEY=
MNG_WEBHOOK_SECRET=
MCP_TOKEN=
